<?xml version="1.0" encoding="utf-8"?>
<!--
    The recording page (macOS RecordingViews.swift RecordingDetailView and RecordingHeader): the header with the
    title, the state, the elapsed time with the size so far and the "screen recorded" glyph, the mic and system meters,
    "Catch up" and the language, the calendar suggestion, the capture warnings and the screen video's notice, pinned on
    top; under them the live transcript (or the wave and why there is none) on the
    left and, on the right, the catch-ups or the live chat under their tabs, the catch-up model and the answer language;
    the gap between them drags to resize them (PaneSplitter), and with Stack Panes the transcript is above the panel.
-->
<UserControl
    x:Class="EchoDiar.App.Views.RecordingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App"
    xmlns:views="using:EchoDiar.App.Views">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- The size tints' orange, as ConversationCard's (Fluent has no theme brush for it). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SizeLargerBrush" Color="#FF9F0A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SizeLargerBrush" Color="#CA5010" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SizeLargerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!--
                RecordingWave: the system accent while recording, the disabled text colour while paused; ThemeResources, so
                a theme switch repaints the bars even while they stand still.
            -->
            <Style x:Key="WaveBarStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="PausedWaveBarStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource TextFillColorDisabledBrush}" />
            </Style>
            <!--
                The size so far, tinted by its SizeLevel as the library's sizes (macOS sizeStyle): secondary, then yellow,
                orange and red (RecordingCard.ShowLiveSize).
            -->
            <Style x:Key="LiveSizeStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="LiveSizeLargeStyle" TargetType="TextBlock" BasedOn="{StaticResource LiveSizeStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="LiveSizeLargerStyle" TargetType="TextBlock" BasedOn="{StaticResource LiveSizeStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SizeLargerBrush}" />
            </Style>
            <Style x:Key="LiveSizeHugeStyle" TargetType="TextBlock" BasedOn="{StaticResource LiveSizeStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <!-- A card: the right panel. -->
            <Style x:Key="PaneStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <StackPanel Spacing="10">
                <!-- The title, saved as it changes (set in code: the model holds it trimmed). -->
                <TextBox
                    x:Name="TitleBox"
                    AutomationProperties.Name="{local:T Text='Title'}"
                    PlaceholderText="{local:T Text='Add a title'}" />
                <Grid x:Name="StatusRow" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <FontIcon
                            x:Name="RecordingIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE7C8;" />
                        <FontIcon
                            x:Name="PausedIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE769;"
                            Visibility="Collapsed" />
                    </Grid>
                    <!--
                        The clock with the size right after it, as " (43 MB)" (the brackets secondary, nothing until the
                        first read is back), then the "screen recorded" glyph while a screen video is starting or running
                        (as the card's; its tooltip and name set in code).
                    -->
                    <StackPanel
                        x:Name="ElapsedPanel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="ElapsedText"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel
                                x:Name="LiveSizePanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LiveSizeStyle}"
                                    Text=" (" />
                                <TextBlock
                                    x:Name="LiveSizeText"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LiveSizeStyle}"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LiveSizeStyle}"
                                    Text=")" />
                            </StackPanel>
                        </StackPanel>
                        <FontIcon
                            x:Name="ScreenGlyph"
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE714;"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock
                        x:Name="StateText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!--
                        ChannelMeters: mic over system, 120 px wide, the labels at least 44 px; side by side, the bars
                        72 px wide, where the row has room (set in code: ApplyMetersLayout).
                    -->
                    <StackPanel
                        x:Name="ChannelMeters"
                        Grid.Column="4"
                        Width="120"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <Grid x:Name="MicMeter" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MicLabelColumn" Width="Auto" MinWidth="44" />
                                <ColumnDefinition x:Name="MicBarColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="MicLabel"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="NoWrap"
                                Text="{local:T Text='Mic'}" />
                            <Border
                                x:Name="MicTrack"
                                Grid.Column="1"
                                Height="5"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                CornerRadius="2.5">
                                <Border
                                    x:Name="MicFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2.5" />
                            </Border>
                        </Grid>
                        <Grid x:Name="SystemMeter" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SystemLabelColumn" Width="Auto" MinWidth="44" />
                                <ColumnDefinition x:Name="SystemBarColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="SystemLabel"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="NoWrap"
                                Text="{local:T Text='System'}" />
                            <Border
                                x:Name="SystemTrack"
                                Grid.Column="1"
                                Height="5"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                CornerRadius="2.5">
                                <Border
                                    x:Name="SystemFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2.5" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!--
                        "Catch up": its help as the button's tooltip; the reason it is off as the host's, as a disabled
                        button shows none; Transparent, so the host is hit-tested under the disabled button.
                    -->
                    <Border
                        x:Name="CatchUpButtonHost"
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Background="Transparent">
                        <Button x:Name="CatchUpButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8FD;" />
                                <TextBlock Text="{local:T Text='Catch up'}" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- The language menu, set in code. -->
                    <ContentPresenter x:Name="LanguageHost" Grid.Column="6" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- The calendar event the recording likely belongs to: Rename links it and takes its title, Not now stops suggesting it. -->
        <InfoBar
            x:Name="SuggestionBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.IconSource>
                <SymbolIconSource Symbol="Calendar" />
            </InfoBar.IconSource>
            <InfoBar.Content>
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AcceptSuggestionButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{local:T Text='Rename'}" />
                    <Button x:Name="DismissSuggestionButton" Content="{local:T Text='Not now'}" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!--
            The picked app could not be isolated: every process except EchoDiar is recorded. Under it, why the screen
            video ended before the recording or could not be turned on (macOS: the screen recording's notice), 8 px
            under the first when both show (RecordingView.UpdateNoticeMargin); in one row, so no empty row adds a gap.
        -->
        <StackPanel Grid.Row="2">
            <InfoBar
                x:Name="GlobalTapWarning"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
            <InfoBar
                x:Name="NoticeBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
        </StackPanel>

        <!-- SilentTapBanner: the app plays but the capture hears only silence. -->
        <InfoBar
            x:Name="SilentTapBanner"
            Grid.Row="3"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning"
            Title="{local:T Text='No system audio'}" />

        <!--
            The transcript on the left; on the right, the panel with its Catch-up | Chat tabs (AppViewModel.RecordingTab);
            50/50 at first, the 10 px gap between them drags to resize them, each at least 240 / 300 px wide (kept by the
            gap: half and half when there is no room for both). Stacked
            (AppSettings.StackedPanes), the transcript above the panel, at least 160 / 200 px high (set in code:
            RecordingView.ApplyLayout).
        -->
        <Grid x:Name="PanesGrid" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The live transcript, or the wave and why there is none. -->
            <Grid x:Name="TranscriptPane">
                <!-- LiveTranscriptView, set in code; shown while the recording has a live transcriber. -->
                <Border x:Name="LiveHost" Visibility="Collapsed" />

                <StackPanel
                    x:Name="NoLivePanel"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <!-- RecordingWave: 24 bars, built in code. -->
                    <StackPanel
                        x:Name="Wave"
                        Height="64"
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Orientation="Horizontal"
                        Spacing="4" />
                    <TextBlock
                        x:Name="ReasonText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <!-- Opens the Settings page the reason names. -->
                    <HyperlinkButton
                        x:Name="OpenSettingsLink"
                        HorizontalAlignment="Center"
                        Content="{local:T Text='Open Settings'}" />
                </StackPanel>
            </Grid>

            <!-- The gap with its grip, as the conversation's (ConversationView). -->
            <views:PaneSplitter
                x:Name="Splitter"
                Grid.Column="1"
                AutomationProperties.Name="{local:T Text='Resize'}">
                <Grid Background="Transparent" Opacity="0.7">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Rectangle
                            Width="1"
                            Height="14"
                            Fill="{ThemeResource TextFillColorSecondaryBrush}"
                            RadiusX="0.5"
                            RadiusY="0.5" />
                        <Rectangle
                            Width="1"
                            Height="14"
                            Fill="{ThemeResource TextFillColorSecondaryBrush}"
                            RadiusX="0.5"
                            RadiusY="0.5" />
                    </StackPanel>
                </Grid>
            </views:PaneSplitter>

            <!--
                One card, as the conversation's AI panel (AIPanelView): a header 10 px inside it (the Catch-up | Chat
                tabs, then the catch-up model, which also answers the chat, the answer language and, on the Catch-up tab,
                Search, then the collapse button), a line, then only the catch-ups or the chat. The header is one row, never
                wrapped: narrower, the language shows only its globe, then the model only its chip, then the tabs only
                their icons, the names in the tooltips, then the menus and buttons narrow; the same step on both tabs
                (RecordingView.FitHeader). Collapsed (AppViewModel.RecordingPanelCollapsed, as each recording starts), the
                rail of tab buttons in its place (macOS CollapsedPanel); the card only hides, so the chat stays.
            -->
            <Grid x:Name="SidePanel" Grid.Column="2">
                <Border x:Name="PanelCard" Style="{StaticResource PaneStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            x:Name="PanelHeader"
                            Margin="10"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- A track of its own: the panel is a card too, so the tabs would blend into it. -->
                            <Border
                                x:Name="PanelTabsTrack"
                                Padding="2"
                                MinHeight="32"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource OverlayCornerRadius}">
                                <SelectorBar x:Name="PanelTabsBar" Padding="0" VerticalAlignment="Center">
                                    <SelectorBar.Resources>
                                        <!--
                                            Compact tabs (macOS: 28 → 24 pt items): 3 px above the name and 1 px under
                                            it, then the 3 px selection pill, instead of 10 and 7. A tab is then 26 px
                                            (a 19 px name), the track 32 px with its padding and border, Fluent's
                                            control height; the name stays centred.
                                            With icons only a tab is shorter: the track keeps 32 px (MinHeight)
                                            and centres them, so the header stays as tall as the AI panel's.
                                        -->
                                        <Style TargetType="SelectorBarItem">
                                            <Setter Property="Padding" Value="12,3,12,1" />
                                        </Style>
                                    </SelectorBar.Resources>
                                    <SelectorBarItem x:Name="CatchUpPanelTab" Text="{local:T Text='Catch-up'}" />
                                    <SelectorBarItem x:Name="ChatPanelTab" Text="{local:T Text='Chat'}" />
                                </SelectorBar>
                            </Border>
                            <!--
                                Margins space the menus: a collapsed one's column would keep a ColumnSpacing. Each as tall
                                as the tabs' track (set in code).
                            -->
                            <Grid
                                x:Name="PanelHeaderMenus"
                                Grid.Column="1"
                                HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- The catch-up provider and model (AIMenus, AIPurpose.CatchUp); never an in-app model. -->
                                <DropDownButton
                                    x:Name="PanelModelButton"
                                    MaxWidth="180"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <!--
                                        A Grid, not a horizontal StackPanel: its star column gives the name a finite width to
                                        trim with "…" inside the button. The name's margin spaces it, so the chip alone (the
                                        name collapsed) keeps no gap.
                                    -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE950;" />
                                        <TextBlock
                                            x:Name="PanelModelText"
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </Grid>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="PanelModelMenu" Placement="BottomEdgeAlignedRight" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <!-- The language of summaries and answers, as the conversation's AI panel. -->
                                <DropDownButton
                                    x:Name="PanelLanguageButton"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                    <!-- The name's margin spaces it, as the model's: the globe alone keeps no gap. -->
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE774;" />
                                        <TextBlock x:Name="PanelLanguageText" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="PanelLanguageMenu" Placement="BottomEdgeAlignedRight" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <!-- Shows or hides the catch-up search field; on the Catch-up tab only. -->
                                <ToggleButton
                                    x:Name="CatchUpSearchButton"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{local:T Text='Search catch-ups'}"
                                    ToolTipService.ToolTip="{local:T Text='Search catch-ups'}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE721;" />
                                </ToggleButton>
                                <!-- The last one, as the AI panel's: folds the panel toward the trailing edge, down when stacked (set in code). -->
                                <Button
                                    x:Name="CollapseButton"
                                    Grid.Column="3"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{local:T Text='Collapse panel'}"
                                    ToolTipService.ToolTip="{local:T Text='Collapse panel'}">
                                    <FontIcon x:Name="CollapseIcon" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE76C;" />
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- Across the card under the header, as the AI panel's. -->
                        <Border
                            Grid.Row="1"
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- The tab's content, 10 px under the line: the search field slides in from 8 px higher, still under it. -->
                        <Grid Grid.Row="2" Padding="0,10,0,0">
                            <!--
                                The search field, then the catch-ups (CatchUpCard, set in code), newest first, the one being
                                written at the top; while there are none, a hint to press Catch up (or that none was found).
                            -->
                            <Border x:Name="CatchUpPanel">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <!--
                                        Filters the catch-ups as typed and highlights the term in them (macOS catchUpSearchField):
                                        slides in under the line, 10 px from the card's edges; Esc clears it, then hides it.
                                    -->
                                    <AutoSuggestBox
                                        x:Name="CatchUpSearchBox"
                                        Margin="10,0,10,0"
                                        AutomationProperties.Name="{local:T Text='Search catch-ups'}"
                                        PlaceholderText="{local:T Text='Search catch-ups'}"
                                        QueryIcon="Find"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="CatchUpEmptyText"
                                        Grid.Row="1"
                                        Margin="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <ScrollViewer
                                        x:Name="CatchUpScroller"
                                        Grid.Row="1"
                                        VerticalScrollBarVisibility="Auto"
                                        Visibility="Collapsed">
                                        <StackPanel x:Name="CatchUpCards" Padding="8" Spacing="6" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- LiveChatView, made in code while the Chat tab is shown. -->
                            <Border x:Name="ChatHost" />
                        </Grid>
                    </Grid>
                </Border>
                <views:CollapsedPanel x:Name="CollapsedRail" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
