<?xml version="1.0" encoding="utf-8"?>
<!--
    The recording page (macOS RecordingViews.swift RecordingDetailView and RecordingHeader): the header with the
    title, the state, the elapsed time, the mic and system meters, "Catch up" and the language, the calendar suggestion
    and the capture warnings, pinned on top; under them the live transcript (or the wave and why there is none) on the
    left and, on the right, the catch-ups or the live chat under their tabs, the catch-up model and the answer language.
-->
<UserControl
    x:Class="EchoDiar.App.Views.RecordingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <!--
            RecordingWave: the system accent while recording, the disabled text colour while paused; ThemeResources, so
            a theme switch repaints the bars even while they stand still.
        -->
        <Style x:Key="WaveBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="PausedWaveBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource TextFillColorDisabledBrush}" />
        </Style>
        <!-- A card: the right panel. -->
        <Style x:Key="PaneStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <StackPanel Spacing="10">
                <!-- The title, saved as it changes (set in code: the model holds it trimmed). -->
                <TextBox
                    x:Name="TitleBox"
                    AutomationProperties.Name="{local:T Text='Title'}"
                    PlaceholderText="{local:T Text='Add a title'}" />
                <Grid x:Name="StatusRow" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <FontIcon
                            x:Name="RecordingIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE7C8;" />
                        <FontIcon
                            x:Name="PausedIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE769;"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBlock
                        x:Name="ElapsedText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="StateText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!--
                        ChannelMeters: mic over system, 120 px wide, the labels at least 44 px; side by side, the bars
                        72 px wide, where the row has room (set in code: ApplyMetersLayout).
                    -->
                    <StackPanel
                        x:Name="ChannelMeters"
                        Grid.Column="4"
                        Width="120"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <Grid x:Name="MicMeter" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MicLabelColumn" Width="Auto" MinWidth="44" />
                                <ColumnDefinition x:Name="MicBarColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="MicLabel"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="NoWrap"
                                Text="{local:T Text='Mic'}" />
                            <Border
                                x:Name="MicTrack"
                                Grid.Column="1"
                                Height="5"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                CornerRadius="2.5">
                                <Border
                                    x:Name="MicFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2.5" />
                            </Border>
                        </Grid>
                        <Grid x:Name="SystemMeter" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SystemLabelColumn" Width="Auto" MinWidth="44" />
                                <ColumnDefinition x:Name="SystemBarColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="SystemLabel"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="NoWrap"
                                Text="{local:T Text='System'}" />
                            <Border
                                x:Name="SystemTrack"
                                Grid.Column="1"
                                Height="5"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                CornerRadius="2.5">
                                <Border
                                    x:Name="SystemFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2.5" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!--
                        "Catch up": its help as the button's tooltip; the reason it is off as the host's, as a disabled
                        button shows none; Transparent, so the host is hit-tested under the disabled button.
                    -->
                    <Border
                        x:Name="CatchUpButtonHost"
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Background="Transparent">
                        <Button x:Name="CatchUpButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8FD;" />
                                <TextBlock Text="{local:T Text='Catch up'}" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- The language menu, set in code. -->
                    <ContentPresenter x:Name="LanguageHost" Grid.Column="6" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- The calendar event the recording likely belongs to: Rename links it and takes its title, Not now stops suggesting it. -->
        <InfoBar
            x:Name="SuggestionBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.IconSource>
                <SymbolIconSource Symbol="Calendar" />
            </InfoBar.IconSource>
            <InfoBar.Content>
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AcceptSuggestionButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{local:T Text='Rename'}" />
                    <Button x:Name="DismissSuggestionButton" Content="{local:T Text='Not now'}" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- The picked app could not be isolated: every process except EchoDiar is recorded. -->
        <InfoBar
            x:Name="GlobalTapWarning"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <!-- SilentTapBanner: the app plays but the capture hears only silence. -->
        <InfoBar
            x:Name="SilentTapBanner"
            Grid.Row="3"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning"
            Title="{local:T Text='No system audio'}" />

        <!-- The transcript on the left; on the right, the panel with its Catch-up | Chat tabs (AppViewModel.RecordingTab). -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The live transcript, or the wave and why there is none. -->
            <Grid x:Name="TranscriptPane">
                <!-- LiveTranscriptView, set in code; shown while the recording has a live transcriber. -->
                <Border x:Name="LiveHost" Visibility="Collapsed" />

                <StackPanel
                    x:Name="NoLivePanel"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <!-- RecordingWave: 24 bars, built in code. -->
                    <StackPanel
                        x:Name="Wave"
                        Height="64"
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Orientation="Horizontal"
                        Spacing="4" />
                    <TextBlock
                        x:Name="ReasonText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <!-- Opens the Settings page the reason names. -->
                    <HyperlinkButton
                        x:Name="OpenSettingsLink"
                        HorizontalAlignment="Center"
                        Content="{local:T Text='Open Settings'}" />
                </StackPanel>
            </Grid>

            <!--
                One card with a header (the Catch-up | Chat tabs, then the catch-up model, which also answers the chat, the
                answer language and, on the Catch-up tab, Search) over the catch-ups or the chat.
            -->
            <Border
                x:Name="SidePanel"
                Grid.Column="1"
                Style="{StaticResource PaneStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="10,10,10,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- A track of its own: the panel is a card too, so the tabs would blend into it. -->
                        <Border
                            Padding="2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <SelectorBar x:Name="PanelTabsBar" Padding="0">
                                <SelectorBarItem x:Name="CatchUpPanelTab" Text="{local:T Text='Catch-up'}" />
                                <SelectorBarItem x:Name="ChatPanelTab" Text="{local:T Text='Chat'}" />
                            </SelectorBar>
                        </Border>
                        <!-- The catch-up provider and model (AIMenus, AIPurpose.CatchUp); never an in-app model. -->
                        <DropDownButton
                            x:Name="PanelModelButton"
                            Grid.Column="1"
                            MaxWidth="180"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{local:T Text='Model for catch-ups and live chat'}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE950;" />
                                <TextBlock
                                    x:Name="PanelModelText"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="PanelModelMenu" Placement="BottomEdgeAlignedRight" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <!-- The language of summaries and answers, as the conversation's AI panel. -->
                        <DropDownButton
                            x:Name="PanelLanguageButton"
                            Grid.Column="2"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE774;" />
                                <TextBlock x:Name="PanelLanguageText" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="PanelLanguageMenu" Placement="BottomEdgeAlignedRight" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <!-- Shows or hides the catch-up search field; on the Catch-up tab only. -->
                        <ToggleButton
                            x:Name="CatchUpSearchButton"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:T Text='Search catch-ups'}"
                            ToolTipService.ToolTip="{local:T Text='Search catch-ups'}">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE721;" />
                        </ToggleButton>
                    </Grid>

                    <!--
                        The search field, then the catch-ups (CatchUpCard, set in code), newest first, the one being
                        written at the top; while there are none, a hint to press Catch up (or that none was found).
                    -->
                    <Border x:Name="CatchUpPanel" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--
                                Filters the catch-ups as typed and highlights the term in them (macOS catchUpSearchField):
                                slides in under the header; Esc clears it, then hides it.
                            -->
                            <AutoSuggestBox
                                x:Name="CatchUpSearchBox"
                                Margin="10,0,10,0"
                                AutomationProperties.Name="{local:T Text='Search catch-ups'}"
                                PlaceholderText="{local:T Text='Search catch-ups'}"
                                QueryIcon="Find"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="CatchUpEmptyText"
                                Grid.Row="1"
                                Margin="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <ScrollViewer
                                x:Name="CatchUpScroller"
                                Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="Collapsed">
                                <StackPanel x:Name="CatchUpCards" Padding="8" Spacing="6" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- LiveChatView, made in code while the Chat tab is shown. -->
                    <Border x:Name="ChatHost" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
