<?xml version="1.0" encoding="utf-8"?>
<!--
    The conversation's screen recording (macOS VideoPaneView.swift): the muted picture in the transcript's card, which
    clips its corners, without transport controls; a click anywhere asks the playback controller to play or pause. Until
    the video is open the pane is a placeholder whose ring fades in after 150 ms; a note covers the picture while the
    play head has none, or when the video is HEVC and no HEVC decoder is installed (set in code).
-->
<UserControl
    x:Class="EchoDiar.App.Views.VideoPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <Grid>
        <!-- Hidden (opacity 0, so it stays laid out) until the video is open and while a note covers it. -->
        <MediaPlayerElement
            x:Name="Picture"
            AreTransportControlsEnabled="False"
            AutomationProperties.Name="{local:T Text='Screen recording'}"
            IsHitTestVisible="False"
            Opacity="0"
            Stretch="Uniform" />

        <!-- Takes the clicks over the whole pane, the picture's included. -->
        <Grid x:Name="ClickLayer" Background="Transparent" />

        <ProgressRing
            x:Name="LoadingRing"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            IsHitTestVisible="False"
            Opacity="0" />

        <TextBlock
            x:Name="NoteText"
            Margin="20,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsHitTestVisible="False"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
