<?xml version="1.0" encoding="utf-8"?>
<!--
    One conversation beside the wide layout's sidebar: its title (double-click to rename) and details, then two columns
    (macOS TranscriptView): the transcript with playback (TranscriptView) on the left, the AI panel with its Summary |
    Chat tabs (AIPanelView) on the right, 50/50 at first, the narrow gap between them drags to resize (PaneSplitter); with
    Stack Panes (AppSettings.StackedPanes), the transcript above the panel instead (set in code). Each pane shows its own
    loading state until its files are read.
-->
<UserControl
    x:Class="EchoDiar.App.Views.ConversationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App"
    xmlns:views="using:EchoDiar.App.Views">

    <!--
        The title and details are above the transcript column only: the AI panel spans both rows, so its card and the
        header inside it line up with the sidebar's, as on macOS. The two columns keep their minimums
        (300 / 280 px, kept by the gap); the gap writes their widths (not saved). The transcript's is the wider. Neither its control row nor the panel's
        header wraps: narrower, their buttons and menus show their icons only. Stacked, the rows are the title, the
        transcript, the gap and the panel, each pane at least 200 px high (ConversationView.ApplyLayout). No row
        spacing: it would also go round the gap; the title's margin spaces it from the transcript.
    -->
    <Grid x:Name="PanesGrid" Margin="0,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Margin="0,0,0,12"
            Padding="4,0"
            Spacing="2">
            <Grid>
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <!-- Enter saves a changed title; Esc or a click elsewhere cancels. -->
                <TextBox
                    x:Name="TitleBox"
                    AutomationProperties.Name="{local:T Text='Title'}"
                    PlaceholderText="{local:T Text='Title'}"
                    Visibility="Collapsed" />
            </Grid>
            <TextBlock
                x:Name="DetailText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <!--
            The transcript's column, one card (macOS b5cdba5): the conversation's video above the transcript, or left of
            it with Stack Panes (macOS TranscriptView withVideoPane), a lined gap between them that drags to resize them;
            the transcript alone without a video or when "Hide video" hides it. The card clips them to its corners. Its
            rows or columns are set in code (ConversationView.ApplyVideoLayout).
        -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid x:Name="TranscriptColumn">
                <!-- Its placeholder from the click's frame, the picture once the video is open. -->
                <views:VideoPaneView x:Name="VideoPane" Visibility="Collapsed" />

                <!--
                    Between the video and the transcript: a 9 px gap with a line across the whole card in its middle
                    (PaneSplitter.Lined, macOS PaneSplit(lined: true)), instead of the panes' grip.
                -->
                <views:PaneSplitter
                    x:Name="VideoSplitter"
                    AutomationProperties.Name="{local:T Text='Resize'}"
                    Lined="True"
                    Visibility="Collapsed" />

                <views:TranscriptView x:Name="TranscriptPane" Visibility="Collapsed" />

                <!--
                    The transcript until its files are read (macOS DetailLoadingPane(framed: false)): the card's area from
                    the click's frame, without a card of its own; the ring fades in only once the reading takes 150 ms, so
                    a fast load does not flash it.
                -->
                <Border x:Name="LoadingPane">
                    <ProgressRing
                        x:Name="LoadingRing"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="False"
                        Opacity="0" />
                </Border>
            </Grid>
        </Border>

        <!--
            The 10 px gap with its grip, two short lines in the middle; the secondary text brush, faded at rest to
            the strong stroke colour, full on hover, drag and keyboard focus.
        -->
        <views:PaneSplitter
            x:Name="Splitter"
            Grid.RowSpan="2"
            Grid.Column="1"
            AutomationProperties.Name="{local:T Text='Resize'}">
            <!-- At rest from the start (PaneSplitter's RestOpacity), so a new conversation does not fade it. -->
            <Grid Background="Transparent" Opacity="0.7">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Rectangle
                        Width="1"
                        Height="14"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                        RadiusX="0.5"
                        RadiusY="0.5" />
                    <Rectangle
                        Width="1"
                        Height="14"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                        RadiusX="0.5"
                        RadiusY="0.5" />
                </StackPanel>
            </Grid>
        </views:PaneSplitter>

        <!-- Its header from the click's frame, its own loading ring until its files are read. -->
        <views:AIPanelView x:Name="AIPanel" Grid.RowSpan="2" Grid.Column="2" />
    </Grid>
</UserControl>
