<?xml version="1.0" encoding="utf-8"?>
<!--
    The conversation's transcript, left of its AI panel (macOS TranscriptView.swift), in the transcript column's card
    (ConversationView, with the video when there is one): the segments, with the version menu pinned above them, a line,
    then a bar with the transcription's state, the speaker notes, playback, the speaker chips (click to rename),
    Show/Hide video, Copy and Re-transcribe.
-->
<UserControl
    x:Class="EchoDiar.App.Views.TranscriptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App"
    xmlns:views="using:EchoDiar.App.Views">

    <UserControl.Resources>
        <!--
            The speakers' colors (TranscriptViewModel.ColorIndex): me in the accent color, the others from the theme's
            caution, success and critical colors, a lighter accent and the secondary text color; the last three repeat the
            first three, since the theme has no more hues. Each follows Light, Dark and contrast themes.
        -->
        <Style x:Key="SpeakerNameBase" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="SpeakerMe" BasedOn="{StaticResource SpeakerNameBase}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Speaker0" BasedOn="{StaticResource SpeakerNameBase}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="Speaker1" BasedOn="{StaticResource SpeakerNameBase}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="Speaker2" BasedOn="{StaticResource SpeakerNameBase}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="Speaker3" BasedOn="{StaticResource SpeakerNameBase}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="Speaker4" BasedOn="{StaticResource SpeakerNameBase}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Speaker5" BasedOn="{StaticResource Speaker0}" TargetType="TextBlock" />
        <Style x:Key="Speaker6" BasedOn="{StaticResource Speaker1}" TargetType="TextBlock" />
        <Style x:Key="Speaker7" BasedOn="{StaticResource Speaker2}" TargetType="TextBlock" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The segments, or a note in their middle while there are none. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                From two kept transcripts: the shown one's number and engine; the others are view-only. 28 px, as the
                summary's version menu, no padding above or below.
            -->
            <DropDownButton
                x:Name="VersionButton"
                Height="28"
                MaxWidth="320"
                Margin="14,16,14,0"
                Padding="11,0"
                HorizontalAlignment="Left"
                ToolTipService.ToolTip="{local:T Text='Earlier transcripts of this conversation'}"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE81C;" />
                    <TextBlock x:Name="VersionText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="VersionMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>

            <!--
                The segments as one selectable text (macOS TranscriptTextView), built in code: per segment the start
                and the speaker (both play from the segment's start), then the text. A drag selects across segments;
                Ctrl+C copies "Name [mm:ss]: text" lines. The segment under the play head has a fill (placed in
                code behind its paragraph, macOS SegmentFragment's row fill), and a speaker icon after its name
                while it plays. No built-in context menu: the code shows its own, with Play from here.
            -->
            <ScrollViewer
                x:Name="SegmentScroller"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <Grid Padding="18,14,18,4">
                    <Canvas IsHitTestVisible="False">
                        <Border
                            x:Name="ActiveFill"
                            Background="{ThemeResource TextFillColorPrimaryBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Opacity="0.12"
                            Visibility="Collapsed" />
                    </Canvas>
                    <RichTextBlock
                        x:Name="SegmentText"
                        ContextFlyout="{x:Null}"
                        IsTextSelectionEnabled="True"
                        SelectionFlyout="{x:Null}"
                        TextWrapping="Wrap" />
                    <Canvas IsHitTestVisible="False">
                        <FontIcon
                            x:Name="SpeakingIcon"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Glyph="&#xE767;"
                            Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <ProgressRing
                x:Name="LoadingRing"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="EmptyPanel"
                Grid.Row="1"
                MaxWidth="480"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center" />
                <!-- The transcription's state while there is no transcript. -->
                <Border x:Name="EmptyStatusHost" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Between the segments and the bar, across the whole card (macOS Divider). -->
        <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Border Grid.Row="2" Padding="14,10">
            <StackPanel Spacing="10">
                <!-- The transcription's state with a transcript: why it failed and Retry, or Needs model. -->
                <Border x:Name="BarStatusHost">
                    <StackPanel
                        x:Name="StatusPanel"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            x:Name="FailureText"
                            MaxWidth="480"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                        <StackPanel
                            x:Name="ProgressPanel"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed">
                            <ProgressRing
                                x:Name="JobRing"
                                Width="16"
                                Height="16"
                                IsActive="True"
                                IsIndeterminate="False"
                                Maximum="1" />
                            <TextBlock
                                x:Name="StepText"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <!-- Opens AI Providers › Local AI › Transcription (macOS openLocalAI(.transcription)). -->
                        <Button
                            x:Name="NeedsModelBadge"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="8,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            BorderThickness="0"
                            CornerRadius="9"
                            ToolTipService.ToolTip="{local:T Text='Download a transcription model in Settings'}"
                            Visibility="Collapsed">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="{local:T Text='Needs model'}" />
                        </Button>
                        <SplitButton
                            x:Name="RetryButton"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{local:T Text='Retry'}" />
                            <SplitButton.Flyout>
                                <MenuFlyout x:Name="RetryMenu" Placement="BottomEdgeAlignedLeft" />
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button
                            x:Name="TranscribeButton"
                            VerticalAlignment="Center"
                            Content="{local:T Text='Transcribe'}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Why the speakers were not told apart (the transcript's notes). -->
                <StackPanel x:Name="NoticePanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <FontIcon
                        x:Name="NoticeIcon"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="NoticeText"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!-- Opens AI Providers › Local AI › Diarization (macOS openLocalAI(.diarization)). -->
                    <HyperlinkButton
                        x:Name="NoticeDownloadButton"
                        Padding="0"
                        VerticalAlignment="Center"
                        Content="{local:T Text='Download…'}"
                        FontSize="12" />
                </StackPanel>

                <views:PlaybackBar x:Name="Player" />

                <!--
                    In place of playback once the audio was moved to the Recycle Bin, or under it while the video still
                    plays (macOS playbackControls: the note beside the transport); its own row, so the control row keeps
                    its room for the video's buttons; trimmed when narrow; what is no longer possible in its tooltip (set
                    in code).
                -->
                <Grid
                    x:Name="AudioRemovedNote"
                    ColumnSpacing="6"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE74F;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Text="{local:T Text='Audio has been removed'}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>

                <!--
                    As macOS: Re-transcribe and Summarize, the video's buttons, Copy, then the speaker chips at the
                    trailing edge. One row, never wrapped (macOS controlRow): fewer chips when it is short ("+N" lists the
                    others), then Re-transcribe and Summarize as icons with their title in the tooltip (FitControlRow).
                -->
                <Grid x:Name="ControlRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ControlButtons">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                            <!-- The speakers without a chip; a click on one renames it. -->
                            <FlyoutBase.AttachedFlyout>
                                <Flyout x:Name="MoreSpeakersFlyout" Placement="Top">
                                    <StackPanel x:Name="MoreSpeakersList" MinWidth="180" Spacing="2" />
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                            <!-- In place of Re-transcribe while a job is queued or runs, with Stop ("Stopping…" once clicked). -->
                            <StackPanel
                                x:Name="TranscribingPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="True" />
                                <!-- Collapsed in the compact row: the status is then the panel's tooltip. -->
                                <TextBlock
                                    x:Name="TranscribingText"
                                    VerticalAlignment="Center"
                                    Text="{local:T Text='Transcribing…'}" />
                                <Button
                                    x:Name="StopTranscriptionButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    AutomationProperties.Name="{local:T Text='Stop transcription'}"
                                    ToolTipService.ToolTip="{local:T Text='Stop transcription'}"
                                    Visibility="Collapsed">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE71A;" />
                                </Button>
                            </StackPanel>
                            <!-- Its title, or in the compact row a refresh icon (its chevron stays). -->
                            <DropDownButton
                                x:Name="RetranscribeButton"
                                Height="28"
                                Padding="11,0"
                                AutomationProperties.Name="{local:T Text='Re-transcribe'}">
                                <Grid>
                                    <TextBlock x:Name="RetranscribeText" Text="{local:T Text='Re-transcribe'}" />
                                    <FontIcon
                                        x:Name="RetranscribeIcon"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Glyph="&#xE72C;"
                                        Visibility="Collapsed" />
                                </Grid>
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="RetranscribeMenu" Placement="TopEdgeAlignedRight" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <!--
                                Opens the Summary tab, and starts a summary when there is none; a ring while it is written. In
                                the compact row a document icon (or the ring alone), the title in the tooltip.
                            -->
                            <Button
                                x:Name="SummarizeButton"
                                Height="28"
                                Padding="11,0"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing
                                        x:Name="SummarizingRing"
                                        Width="16"
                                        Height="16"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <FontIcon
                                        x:Name="SummarizeIcon"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Glyph="&#xE8A5;"
                                        Visibility="Collapsed" />
                                    <TextBlock x:Name="SummarizeText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!--
                                With a video (macOS videoToggle): shows or hides its pane, saved in the settings ("Hide
                                video" while it shows, with the video icon; "Show video" with it struck through).
                            -->
                            <Button
                                x:Name="VideoToggleButton"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Visibility="Collapsed">
                                <Grid Width="16" Height="16">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE714;" />
                                    <Line
                                        x:Name="VideoToggleSlash"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.5"
                                        Visibility="Collapsed"
                                        X1="1"
                                        X2="15"
                                        Y1="1"
                                        Y2="15" />
                                </Grid>
                            </Button>
                            <!--
                                With a video (macOS exportVideoButton and deleteVideoButton): Export video… opens the export
                                dialog; Delete video… ("Delete video" without confirmation) moves it to the Recycle Bin.
                                Disabled while the conversation is recorded, compressed or transcribed.
                            -->
                            <Button
                                x:Name="ExportVideoButton"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Style="{StaticResource SubtleButtonStyle}"
                                AutomationProperties.Name="{local:T Text='Export video…'}"
                                ToolTipService.ToolTip="{local:T Text='Export video…'}"
                                Visibility="Collapsed">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE72D;" />
                            </Button>
                            <Button
                                x:Name="DeleteVideoButton"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Visibility="Collapsed">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE74D;" />
                            </Button>
                            <Button
                                x:Name="CopyButton"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Style="{StaticResource SubtleButtonStyle}"
                                AutomationProperties.Name="{local:T Text='Copy transcript'}"
                                IsEnabled="False"
                                ToolTipService.ToolTip="{local:T Text='Copy transcript'}">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE8C8;" />
                            </Button>
                        </StackPanel>

                    </Grid>

                    <!-- As many chips as fit, then "+N" (ChipRowPanel): a narrow row never cuts a chip off. -->
                    <views:ChipRowPanel
                        x:Name="ChipsPanel"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Spacing="6">
                        <views:ChipRowPanel.Resources>
                            <!-- The chips and "+N" (made in code): as tall as the bar's buttons, 2 px less at the sides. -->
                            <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                                <Setter Property="Height" Value="28" />
                                <Setter Property="Padding" Value="9,0" />
                            </Style>
                        </views:ChipRowPanel.Resources>
                        <!-- The rename field of a chip: Enter saves, Esc or a click elsewhere cancels. -->
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="RenameFlyout" Placement="Top">
                                <StackPanel Width="220" Spacing="8">
                                    <TextBlock
                                        x:Name="RenameTitle"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="RenameBox" />
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </views:ChipRowPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--
            The theme's brushes for the text built in code (TranscriptView.SpeakerBrush): the speakers' colors (me, then
            0 to 7) and the start's color. Elements in the tree, so they follow Light, Dark and
            contrast themes like the styles do.
        -->
        <StackPanel x:Name="Swatches" Visibility="Collapsed">
            <TextBlock Style="{StaticResource SpeakerMe}" />
            <TextBlock Style="{StaticResource Speaker0}" />
            <TextBlock Style="{StaticResource Speaker1}" />
            <TextBlock Style="{StaticResource Speaker2}" />
            <TextBlock Style="{StaticResource Speaker3}" />
            <TextBlock Style="{StaticResource Speaker4}" />
            <TextBlock Style="{StaticResource Speaker5}" />
            <TextBlock Style="{StaticResource Speaker6}" />
            <TextBlock Style="{StaticResource Speaker7}" />
            <TextBlock x:Name="SecondarySwatch" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
