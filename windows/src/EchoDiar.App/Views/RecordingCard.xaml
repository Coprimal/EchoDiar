<?xml version="1.0" encoding="utf-8"?>
<!--
    The recording in the library, above the conversations (macOS RecordingViews.swift RecordingCard): the source,
    the title (double-click to rename) or "Recording…" or "Paused", the elapsed time, mini meters, a glyph while the
    screen is recorded too and the size so far, then a row with
    Stop, Pause or Resume and Mute or Unmute (also in the context menu). A click opens the recording page; selected
    (that page is shown) adds the accent fill and edge. Focusable, so the window's ↑ to it moves the focus off the
    conversation card below (whose Delete would delete that hidden conversation); its focus visual (with the keyboard) hugs the card.
-->
<UserControl
    x:Class="EchoDiar.App.Views.RecordingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App"
    FocusVisualMargin="0,4"
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- The size tints' orange, as ConversationCard's (Fluent has no theme brush for it). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SizeLargerBrush" Color="#FF9F0A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SizeLargerBrush" Color="#CA5010" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SizeLargerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- The Mute button's glyph while the mic is muted, by Mute or by the system. -->
            <Style x:Key="MutedMicIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <!--
                The size so far, tinted by its SizeLevel as the library's sizes (macOS sizeStyle): secondary, then
                yellow, orange and red (RecordingCard.ShowLiveSize); ThemeResources, so a theme switch repaints it.
            -->
            <Style x:Key="LiveSizeStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="LiveSizeLargeStyle" TargetType="TextBlock" BasedOn="{StaticResource LiveSizeStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="LiveSizeLargerStyle" TargetType="TextBlock" BasedOn="{StaticResource LiveSizeStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SizeLargerBrush}" />
            </Style>
            <Style x:Key="LiveSizeHugeStyle" TargetType="TextBlock" BasedOn="{StaticResource LiveSizeStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,4">
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="CardMenu">
                <MenuFlyoutItem x:Name="StopItem" Text="{local:T Text='Stop'}" />
                <MenuFlyoutItem x:Name="PauseItem" />
                <MenuFlyoutItem x:Name="MuteItem" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- On the sidebar's card panel: a subtle fill sets it apart (lighter in Dark, greyer in Light). -->
        <Border
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}" />
        <Border
            x:Name="SelectionFill"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Opacity="0.18"
            Visibility="Collapsed" />

        <Grid x:Name="ContentGrid" Padding="12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Windows has no app icon here yet: the speaker stands for the recorded source. -->
            <FontIcon
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE767;" />

            <StackPanel Grid.Column="1" Spacing="4">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Ellipse
                            x:Name="RecordingDot"
                            Width="8"
                            Height="8"
                            Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Ellipse
                            x:Name="PausedDot"
                            Width="8"
                            Height="8"
                            Fill="{ThemeResource SystemFillColorCautionBrush}"
                            Visibility="Collapsed" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <TextBlock
                            x:Name="StateText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBox
                            x:Name="TitleBox"
                            Padding="4,2"
                            MinHeight="0"
                            AutomationProperties.Name="{local:T Text='Title'}"
                            PlaceholderText="{local:T Text='Add a title'}"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ElapsedText"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!--
                        The mini meters, the "screen recorded" glyph and the size so far, in one panel: a collapsed one
                        keeps no gap.
                    -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <!-- Mic over system, 44 px wide. -->
                        <StackPanel
                            x:Name="MiniMeters"
                            Width="44"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Spacing="2">
                            <Border Height="3" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" CornerRadius="1.5">
                                <Border
                                    x:Name="MicFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1.5" />
                            </Border>
                            <Border Height="3" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" CornerRadius="1.5">
                                <Border
                                    x:Name="SystemFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1.5" />
                            </Border>
                        </StackPanel>
                        <!--
                            A screen video is starting or running (macOS: rectangle.dashed.badge.record in Palette's red
                            screen colour), as the toolbar's screen button while on: the video glyph in the critical red; its
                            tooltip and name set in code.
                        -->
                        <FontIcon
                            x:Name="ScreenGlyph"
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE714;"
                            Visibility="Collapsed" />
                        <!-- Nothing until the first read is back. -->
                        <TextBlock
                            x:Name="LiveSizeText"
                            VerticalAlignment="Center"
                            MaxLines="1"
                            Style="{StaticResource LiveSizeStyle}"
                            TextWrapping="NoWrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock
                        x:Name="SourceText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Stop, Pause or Resume, Mute or Unmute, then the language menu (added in code). -->
                <StackPanel
                    x:Name="ButtonRow"
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        x:Name="StopButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Stop'}"
                        ToolTipService.ToolTip="{local:T Text='Stop recording'}">
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="15"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE71A;" />
                    </Button>
                    <Button x:Name="PauseButton" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon
                            x:Name="PauseIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="15"
                            Glyph="&#xE769;" />
                    </Button>
                    <Button x:Name="MuteButton" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon
                            x:Name="MuteIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="15"
                            Glyph="&#xE720;" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border
            x:Name="SelectionStroke"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="1.5"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
