<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EchoDiar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App"
    xmlns:views="using:EchoDiar.App.Views"
    Title="EchoDiar">

    <!-- The theme's solid background where no system backdrop is set; cleared in code under Mica or Acrylic. -->
    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The header on the window's backdrop, like Paint: the title row (the title bar) and the toolbar row. -->
        <views:TitleBarToolbar x:Name="Toolbar" />

        <!-- The body on its own layer, a line below the header (the Windows 11 layer on Mica). -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- GlobalTapNote (macOS MainView.swift): before recording, the picked app cannot be recorded on its own. -->
                <InfoBar
                    x:Name="GlobalTapNote"
                    Margin="12,12,12,0"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational"
                    Visibility="Collapsed" />

                <!--
                    The library as a 360 px sidebar, then the detail: a conversation, the recording, or the welcome pane
                    when nothing is open. Settings: its page alone, with its own sidebar.
                -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="360" />
                        <ColumnDefinition x:Name="DetailColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The library sidebar (macOS libraryPage): its header on the window, then one card (macOS
                        libraryWell) with the cards or the library chat (ListHost). The header (macOS sidebarHeader), at
                        the AI panel header's height: the Conversations | Global Chat tabs in a track (GlobalChatOpen) and
                        the search button; expanded (the button, Ctrl+F), the search box across the width and its close
                        button in their place, at the tabs' height so the card under it does not move.
                    -->
                    <Grid x:Name="SidebarPane" Margin="12,8,12,12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="SidebarHeader">
                            <Grid>
                                <Grid x:Name="SidebarTabsRow" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- On the window, as the AI panel's tabs: a track of the cards' fill. -->
                                    <Border
                                        Padding="2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource OverlayCornerRadius}">
                                        <SelectorBar x:Name="SidebarTabsBar" Padding="0">
                                            <SelectorBarItem x:Name="ConversationsTab" Text="{local:T Text='Conversations'}" />
                                            <SelectorBarItem x:Name="ChatTab" Text="{local:T Text='Global Chat'}" />
                                        </SelectorBar>
                                    </Border>
                                    <!-- From the Chat tab it shows Conversations first: the search filters the cards. -->
                                    <Button
                                        x:Name="SearchButton"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{local:T Text='Search conversations'}"
                                        ToolTipService.ToolTip="{local:T Text='Search conversations'}">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE721;" />
                                    </Button>
                                </Grid>

                                <!-- Filters the cards as typed (macOS sidebarSearchField); Esc clears it, then collapses it. -->
                                <Grid
                                    x:Name="SearchRow"
                                    VerticalAlignment="Center"
                                    ColumnSpacing="8"
                                    Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <AutoSuggestBox
                                        x:Name="SearchBox"
                                        AutomationProperties.Name="{local:T Text='Search conversations'}"
                                        PlaceholderText="{local:T Text='Search conversations'}"
                                        QueryIcon="Find" />
                                    <Button
                                        x:Name="CloseSearchButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{local:T Text='Close search'}"
                                        ToolTipService.ToolTip="{local:T Text='Close search'}">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <!-- 8 px under the card's top edge, as under the header when it was inside the card. -->
                            <ContentControl
                                x:Name="ListHost"
                                Margin="0,8,0,0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False" />
                        </Border>
                    </Grid>

                    <!-- The recording page, one conversation, the welcome pane or Settings. -->
                    <ContentControl
                        x:Name="RouteHost"
                        Grid.Column="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
